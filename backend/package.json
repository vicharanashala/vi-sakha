{
  "name": "vinternship-backend",
  "version": "1.0.0",
  "description": "Vinternship Support System Backend",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "clean": "node -e \"const fs=require('fs'); ['dist', 'tsconfig.tsbuildinfo', 'tsconfig.build.tsbuildinfo'].forEach(f => fs.rmSync(f, {recursive:true, force:true}))\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "prestart:dev": "npm run clean",
    "start:dev": "nest start --watch",
    "prestart:debug": "npm run clean",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:qa": "ts-node src/scripts/seed-qa.ts",
    "export-yaml": "ts-node src/scripts/export-swagger.ts",
    "mcp:server": "node dist/modules/rag/mcp/stdio-server.js"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^1.1.24",
    "@langchain/core": "^1.1.35",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/websockets": "^10.4.22",
    "@types/passport-google-oauth20": "^2.0.17",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.3.0",
    "firebase-admin": "^13.7.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "mongoose": "^8.0.0",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "@visakha/agent-orchestrator": "file:../services/agent-orchestrator",
    "@visakha/config": "file:../packages/config",
    "@visakha/shared-types": "file:../packages/shared-types",
    "@visakha/shared-utils": "file:../packages/shared-utils"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.17",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
