# Backend Environment Variables
# Copy to .env and fill in values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/vinternship

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-secret-in-production
API_KEY_SECRET=change-this-for-secure-api-key-encryption

# Optional: Separate MongoDB source for LibreChat plugin
# If unset, LibreChat plugin will read from MONGODB_URI database.
LIBRECHAT_MONGODB_URI=
LIBRECHAT_DB_NAME=
LIBRECHAT_FETCH_LIMIT=2000

# Server Port
PORT=3000

# API Keys (for RAG functionality)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Embedding Sidecar (bot/rag/embed_sidecar.py — run on port 8001)
# Used by: QaProposalsService (approval embedding) + EmbeddingWorkerService (pipeline backfill)
# Start with: uvicorn bot.rag.embed_sidecar:app --port 8001
EMBEDDING_SIDECAR_URL=http://localhost:8001
RAG_API_URL=http://localhost:8001

# Discord Bot Token (for discord-ingestion live listener)
DISCORD_BOT_TOKEN=

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Google OAuth (used for both Sign-In and Google Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
