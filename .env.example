# Environment template - copy to .env and fill values
# DO NOT commit .env to git

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# Notification System & Background Processing
# Set up a Gmail account and generate an "App Password" for GMAIL_PASS
REDIS_HOST=localhost
REDIS_PORT=6379
GMAIL_USER=your-system-email@gmail.com
GMAIL_PASS=your-google-app-password
FRONTEND_URL=http://localhost:5173
